{
  "name": "market-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "find scripts src -name '*.mjs' -print -exec node --check {} \\;",
    "start:feishu": "node scripts/feishu-bot-daemon.mjs",
    "start:market-bot": "FEISHU_AGENT_CONTEXT_FILES=prompts/market-personality.md FEISHU_AGENT_COMMAND='node scripts/feishu-agent.mjs' node scripts/feishu-bot-daemon.mjs",
    "service:start": "node scripts/feishu-service.mjs start",
    "service:stop": "node scripts/feishu-service.mjs stop",
    "service:restart": "node scripts/feishu-service.mjs restart",
    "service:status": "node scripts/feishu-service.mjs status",
    "agent": "node scripts/feishu-agent.mjs"
  }
}
